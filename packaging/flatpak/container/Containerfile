FROM docker.io/debian:13

ENV DEBIAN_FRONTEND=noninteractive
RUN apt update \
	&& apt install -y --no-install-recommends \
		flatpak flatpak-builder ostree appstream desktop-file-utils \
		ca-certificates git python3 \
	&& rm -rf /var/lib/apt/lists/*

RUN flatpak remote-add --if-not-exists flathub \
		https://flathub.org/repo/flathub.flatpakrepo \
	&& flatpak install -y flathub \
		org.kde.Platform//6.9 org.kde.Sdk//6.9 org.flatpak.Builder

# the repo is bind-mounted at /src; git refuses to read a tree it thinks
# another user owns, which happens under rootful podman, so trust it here.
RUN git config --global --add safe.directory /src

WORKDIR /src
